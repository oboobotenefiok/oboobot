# oboobot reads every credential from the process environment directly
# (std::env::var), never from a .env file: there is no dotenv loading
# anywhere in this codebase. In the deployed case, every variable below
# is set as a GitHub Actions secret and injected via trading.yml's
# `env:` block. This file exists only as a reference for what to set
# when testing locally (e.g. `export $(grep -v '^#' .env.example | xargs)`
# after filling in real values, or setting them however your shell
# prefers) and, if you fork this project, for which secrets to add
# under Settings -> Secrets and variables -> Actions.

# Required for --broker deriv.
DERIV_APP_ID=
DERIV_API_TOKEN=

# Required for --broker bybit. BybitAdapter is currently a stub; see
# the README's "Remaining Gaps" section.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Only needed if config.toml's [notifications] section names these
# (or your own chosen variable names) under slack_webhook_env /
# telegram_bot_token_env / telegram_chat_id_env. Leave [notifications]
# empty in config.toml to disable notifications entirely.
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only needed by the trading.yml GitHub Actions workflow itself (to
# check out and push to the separate state repository), never read by
# the daemon binary directly.
STATE_REPO_TOKEN=
